# Environment variables template for NightVision Gen
# Copy this file to .env and adjust paths according to your environment.

# Paths
NIGHTVISION_ROOT=.
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
CHECKPOINTS_DIR=./artifacts/checkpoints

# Hardware & Execution
CUDA_VISIBLE_DEVICES=0
NUM_WORKERS=4
SEED=42

# Google Drive (for Colab runs)
GDRIVE_MOUNT_POINT=/content/drive
GDRIVE_PROJECT_PATH=/content/drive/MyDrive/NightVision_Gen

